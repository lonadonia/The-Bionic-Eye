    {
      "where": "copy.system.lede",
      "text": "The C10 isn’t just a drone; it’s a precision instrument. The drone is equipped with advanced avionics designed specifically for stability near structures.",
      "status": "VERBATIM",
      "evidence": "BRO p.6"
    },
    {
      "where": "copy.system.radar.title",
      "text": "Automatic Radar-Controlled Distance System",
      "status": "VERBATIM",
      "evidence": "BRO p.6"
    },
    {
      "where": "copy.system.radar.body",
      "text": "Precision is key. The C10 features a front-mounted radar that measures the distance to the wall with an accuracy of 2–6 cm (≈ 0.8–2.4 in).",
      "status": "VERBATIM",
      "evidence": "BRO p.6"
    },
    {
      "where": "copy.system.radar.points[0].lead",
      "text": "How it works:",
      "status": "VERBATIM",
      "evidence": "BRO p.6"
    },
    {
      "where": "copy.system.radar.points[0].text",
      "text": "The pilot sets a “Desired Distance” (e.g., 1.5 metres (≈ 4.9 ft)). The drone automatically maintains this position relative to the surface, ensuring even cleaning.",
      "status": "VERBATIM",
      "evidence": "BRO p.6"
    },
    {
      "where": "copy.system.radar.points[1].lead",
      "text": "Emergency Push:",
      "status": "VERBATIM",
      "evidence": "BRO p.6"
    },
    {
      "where": "copy.system.radar.points[1].text",
      "text": "If the drone detects it is too close to the wall (e.g., due to a wind gust), the system automatically pushes the drone back to a safe distance (up to 2 metres (≈ 6.6 ft)) and switches to manual loiter mode for safety.",
      "status": "VERBATIM",
      "evidence": "BRO p.6"
    },
    {
      "where": "copy.system.rtk.title",
